  "resolution": [
    {
      "step": 1,
      "entity": "team",
      "source": "GET /teams",
      "requiredScope": ["clubId", "category", "division", "gender"],
      "note": "Use original IDs/metadata; fail closed if the intended team is ambiguous."
    },
    {
      "step": 2,
      "entity": "tournament",
      "source": "GET /teams/{teamId}/tournaments",
      "requiredScope": ["season", "tournament/competition", "category", "division", "gender"],
      "note": "The selected tournamentId must be returned for the selected teamId."
    },
    {
      "step": 3,
      "entity": "roster",
      "source": "GET /athletes/athletesByTeam/{teamId}?tournamentId={tournamentId}",
      "requiredParameters": ["teamId", "tournamentId"],
      "response": "array<AthleteIdentity>"
    }
  ],
