  "matches": {
    "list": {
      "method": "GET",
      "path": "/matches",
      "query": {
        "pagination": ["limit", "skip"],
        "confirmed_filters": ["tournamentId", "teamId", "status", "date", "sortBy"],
        "date_operator_encoding": ["$gte:<ISO-8601>", "$lte:<ISO-8601>"],
        "array_encoding": "comma-separated"
      },
      "response_page": ["items", "count", "next", "prev"]
    },
    "by_id": {
      "method": "GET",
      "path_template": "/matches/{matchId}"
    },
    "subresources": {
      "live_update": "/matches/{matchId}/live-update",
      "formation": "/matches/{matchId}/formation",
      "preview": "/matches/{matchId}/preview",
      "mvp_results": "/matches/{matchId}/mvp/results",
      "stats": "/matches/{matchId}/stats",
      "referees": "/matches/{matchId}/referees",
      "coaching_staff": "/matches/{matchId}/coachingStaff",
      "events": "/matches/{matchId}/events",
      "team_played_count": "/matches/tournaments/{tournamentId}/teams/{teamId}/played-count",
      "top_scorers": "/athletes/topScorers/{matchId}"
    }
  },
  "proven_paths": {
    "tournament_to_matches": {
      "client_method": "getMatchesByTournamentId",
      "semantic_request": "GET /matches?tournamentId={tournamentId}&limit=0",
      "fixture_sort": "matchday:asc",
      "alternate_grid_sort": "round:asc"
    },
    "team_to_matches": {
      "semantic_filters": ["tournamentId", "teamId", "limit"],
      "upcoming": {
        "date": "$gte:<ISO-8601>",
        "sortBy": "date:asc"
      },
      "past": {
        "date": "$lte:<ISO-8601>",
        "sortBy": "date:desc",
        "status": "finalized"
      }
    }
  },
